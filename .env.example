ADDR=:8080
DATA_DIR=./data
SITE_NAME=Patrick's WWW Page
# Set this only after the final public hostname is confirmed.
BASE_URL=https://relay.example.net
# Keep the relay listener private behind your reverse proxy.
RELAY_BIND_ADDR=127.0.0.1
# Generate distinct, high-entropy values. Never commit the populated .env file.
ADMIN_TOKEN=replace-with-a-generated-secret
OBSERVATORY_HMAC_KEY=replace-with-a-generated-secret
MAX_WRITE_BYTES=65536
WRITE_RATE_PER_HOUR=60
